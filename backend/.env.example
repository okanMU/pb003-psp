# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/psp_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Webhook
WEBHOOK_SECRET=whsec_your_webhook_secret_key

# Server
PORT=3000
NODE_ENV=development

# Payment Settings
PAYMENT_EXPIRY_MINUTES=30
MIN_PAYMENT_AMOUNT=10
MAX_PAYMENT_AMOUNT=50000

# Commission Rates
PLATFORM_COMMISSION_RATE=0.015
PSP_COMMISSION_RATE=0.005

# Admin
ADMIN_EMAIL=admin@psp.local
ADMIN_PASSWORD=admin123
