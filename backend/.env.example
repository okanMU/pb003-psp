# Node Environment
NODE_ENV=development

# Server
PORT=3000
API_PREFIX=api/v1

# Database
DATABASE_URL=postgresql://psp_user:psp_password_dev_2024@localhost:5432/psp_development?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=super-secret-jwt-key-change-in-production-2024
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=*

# Prisma
PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1

# Logging
LOG_LEVEL=debug

# Webhook
WEBHOOK_TIMEOUT_MS=30000
WEBHOOK_MAX_RETRIES=5

# Payment
PAYMENT_EXPIRY_MINUTES=30
COLLATERAL_LOCK_MINUTES=35
APPROVAL_TIMEOUT_MINUTES=5
