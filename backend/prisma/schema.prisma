// Prisma Schema for PSP

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Kullanıcılar (Admin, Hesap Sahipleri, Platform Admins)
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password_hash String
  name          String?
  role          UserRole @default(OPERATOR)
  is_active     Boolean  @default(true)

  // Platform ilişkisi (PLATFORM_ADMIN için)
  platform_id   String?
  platform      Platform? @relation("PlatformAdmins", fields: [platform_id], references: [id])

  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // İlişkiler
  owned_banks       Bank[]        @relation("BankOwner")
  approved_payments Transaction[] @relation("ApprovedBy")
  rejected_payments Transaction[] @relation("RejectedBy")

  @@map("users")
}

enum UserRole {
  PSP_ADMIN       // PSP Platform Yöneticisi
  BANK_OWNER      // Hesap Sahibi
  PLATFORM_ADMIN  // Platform Yöneticisi
  OPERATOR        // Operatör
}

// Platformlar (Entegre olan sistemler)
model Platform {
  id              String   @id @default(cuid())
  name            String
  api_key         String   @unique
  webhook_url     String?
  webhook_secret  String?

  commission_rate Decimal  @default(0.015) @db.Decimal(5, 4) // 1.5%
  is_active       Boolean  @default(true)

  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // İlişkiler
  admins          User[]        @relation("PlatformAdmins")
  transactions    Transaction[]
  webhooks        WebhookLog[]

  @@map("platforms")
}

// Bankalar (Hesaplar)
model Bank {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique // GARANTI, ISBANK, etc.
  iban        String
  account_name String

  // TEM İNAT SİSTEMİ
  collateral_limit      Decimal  @default(0) @db.Decimal(15, 2)  // Teminat limiti (örn: 500,000 TRY)
  used_collateral       Decimal  @default(0) @db.Decimal(15, 2)  // Kilitli tutar
  available_collateral  Decimal  @default(0) @db.Decimal(15, 2)  // Kullanılabilir = limit - used

  // SAHİPLİK
  owner_id    String?
  owner       User?    @relation("BankOwner", fields: [owner_id], references: [id])

  // DURUM
  is_active   Boolean  @default(true)
  is_suspended Boolean @default(false)  // Teminat dolunca true
  api_enabled Boolean  @default(false)
  api_config  Json?

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  transactions Transaction[]
  collateral_locks CollateralLock[]

  @@index([is_active, is_suspended, available_collateral])
  @@map("banks")
}

// İşlemler (Payments/Transactions)
model Transaction {
  id                String            @id @default(cuid())
  transaction_code  String            @unique // PAY123456

  // İlişkiler
  platform_id       String
  platform          Platform          @relation(fields: [platform_id], references: [id])
  bank_id           String
  bank              Bank              @relation(fields: [bank_id], references: [id])

  // Ödeme Bilgileri
  amount            Decimal           @db.Decimal(12, 2)
  currency          String            @default("TRY")
  status            PaymentStatus     @default(PENDING)

  // Müşteri Bilgileri
  customer_email    String?
  customer_phone    String?
  customer_name     String?
  customer_ip       String?

  // Metadata
  metadata          Json?
  platform_order_id String?

  // Komisyonlar
  platform_commission Decimal?        @db.Decimal(12, 2)
  psp_commission      Decimal?        @db.Decimal(12, 2)
  net_amount          Decimal?        @db.Decimal(12, 2)

  // Onay/Red
  approved_by_id    String?
  approved_by       User?             @relation("ApprovedBy", fields: [approved_by_id], references: [id])
  approved_at       DateTime?

  rejected_by_id    String?
  rejected_by       User?             @relation("RejectedBy", fields: [rejected_by_id], references: [id])
  rejected_at       DateTime?
  rejection_reason  String?

  // Admin Notları
  admin_notes       String?

  // Fraud Detection
  fraud_score       Int?              @default(0) // 0-100
  risk_level        String?           @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  fraud_rules       Json?             // Triggered rules details

  // Zaman Bilgileri
  expires_at        DateTime
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt

  // TEM İNAT KİLİDİ
  collateral_lock   CollateralLock?
  lock_expires_at   DateTime?

  events            PaymentEvent[]

  @@index([transaction_code])
  @@index([platform_id, status])
  @@index([status, expires_at])
  @@index([created_at])
  @@map("transactions")
}

enum PaymentStatus {
  PENDING      // Bekliyor
  APPROVED     // Onaylandı
  REJECTED     // Reddedildi
  EXPIRED      // Süresi doldu
  CANCELLED    // İptal edildi
}

// Ödeme Olayları (Event Log)
model PaymentEvent {
  id              String   @id @default(cuid())
  transaction_id  String
  transaction     Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)

  event_type      String   // created, pending, approved, rejected, expired
  data            Json?

  created_at      DateTime @default(now())

  @@index([transaction_id, created_at])
  @@map("payment_events")
}

// Webhook Logları
model WebhookLog {
  id              String   @id @default(cuid())
  platform_id     String
  platform        Platform @relation(fields: [platform_id], references: [id])

  transaction_id  String?
  event_type      String
  payload         Json

  status          WebhookStatus @default(PENDING)
  response_code   Int?
  response_body   String?
  error_message   String?

  attempts        Int      @default(0)
  next_retry_at   DateTime?

  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([platform_id, status])
  @@index([next_retry_at])
  @@map("webhook_logs")
}

enum WebhookStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

// Teminat Kilitleri (Collateral Locks)
model CollateralLock {
  id              String      @id @default(cuid())

  // İlişkiler
  bank_id         String
  bank            Bank        @relation(fields: [bank_id], references: [id])
  transaction_id  String      @unique
  transaction     Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)

  // Tutar ve Zaman
  locked_amount   Decimal     @db.Decimal(12, 2)
  locked_at       DateTime    @default(now())
  expires_at      DateTime    // locked_at + 5 dakika
  released_at     DateTime?

  // Durum
  status          LockStatus  @default(ACTIVE)

  // Metadata
  metadata        Json?

  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  @@index([bank_id, status])
  @@index([status, expires_at])
  @@index([transaction_id])
  @@map("collateral_locks")
}

enum LockStatus {
  ACTIVE      // Kilitli (işlem devam ediyor)
  RELEASED    // Serbest bırakıldı (onay/red sonrası)
  EXPIRED     // Süresi doldu (timeout)
}

// Sistem Ayarları
model Setting {
  id         String   @id @default(cuid())
  key        String   @unique
  value      String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("settings")
}
